# .env.example - Copy this file to .env and customize for your machine
# This file is safe to commit. Never commit your actual .env file.

# Path on your host machine that will be mounted into the container at /workspace.
# Examples:
#   Windows:   HOST_PROJECTS=C:/Users/yourname/projects/my-repo
#   WSL:       HOST_PROJECTS=/home/yourname/projects/my-repo
#   macOS/Linux: HOST_PROJECTS=/Users/yourname/projects/my-repo
#
# If left empty, docker-compose.yml defaults to mounting the current directory.
HOST_PROJECTS=

# Optional: Mount your Windows/macOS SSH keys into the container (uncomment if needed)
# SSH_DIR=C:/Users/yourname/.ssh
# SSH_DIR=/home/yourname/.ssh

# Optional: Mount your global git config (read-only)
# GITCONFIG_PATH=C:/Users/yourname/.gitconfig
# GITCONFIG_PATH=/home/yourname/.gitconfig

# You can add any other variables you want passed into the container here.
# They will be available both for volume paths and inside the container.